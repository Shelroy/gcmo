{
  "$schema": "https://unpkg.com/wrangler@4.20.0/config-schema.json",
  "name": "gcmc",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  // Keep variables that were added in the Cloudflare dashboard when deploying
  "keep_vars": true,
  "observability": { "enabled": true }
}
